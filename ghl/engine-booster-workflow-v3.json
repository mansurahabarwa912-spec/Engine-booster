{
  "name": "Engine Booster v3 - Bill to Underwriting + DSCR + Lender (USA) - Edge",
  "browser": "Microsoft Edge (Chromium) - NOT Internet Explorer",
  "trigger": {
    "type": "form_submitted",
    "form_name": "Engine Booster - Upload Utility Bill"
  },
  "steps": [
    {
      "step": 1,
      "action": "Webhook POST to Render",
      "url": "https://YOUR-RENDER-URL/api/v1/underwrite-bill"
    },
    {
      "step": 2,
      "action": "Wait 10s - Render pushes fields to GHL"
    },
    {
      "step": 3,
      "condition": "ai_underwriting_review_flag == GREEN",
      "then": "Move to Approved - Preliminary + Send GREEN email"
    },
    {
      "step": 4,
      "condition": "AMBER",
      "then": "Move to Conditional Review + Task bank statements / PG"
    },
    {
      "step": 5,
      "condition": "RED",
      "then": "Move to Needs Review + Send C-PACE/PPA email"
    },
    {
      "step": 6,
      "action": "If ai_dscr >= 1.25",
      "then": "Tag: Bankable + Notify best lender ai_best_lender"
    }
  ],
  "custom_fields": [
    "property_address",
    "ai_estimated_annual_solar_production_kwh",
    "ai_pvwatts_production_per_kw",
    "ai_preliminary_system_size_kw",
    "ai_electricity_rate_kwh",
    "ai_estimated_year_1_savings_",
    "ai_simple_payback_period_years",
    "ai_estimated_project_cost_",
    "ai_preliminary_tax_credit_rate_",
    "ai_estimated_tax_credit",
    "ai_project_cost",
    "ai_net_project_cost",
    "ai_estimated_depreciation_benefit",
    "ai_estimated_depreciation_tax_savings",
    "ai_year_1_net_economic_benefit",
    "ai_incentive_adjusted_payback",
    "ai_underwriting_review_flag",
    "ai_underwriting_summary",
    "ai_underwriting_report_url",
    "ai_annual_revenue",
    "ai_noi_with_solar",
    "ai_down_payment",
    "ai_loan_amount",
    "ai_loan_rate",
    "ai_loan_term_years",
    "ai_monthly_loan_payment",
    "ai_annual_debt_service",
    "ai_dscr",
    "ai_dscr_without_solar",
    "ai_max_financeable_loan",
    "ai_recommended_lender",
    "ai_recommended_product",
    "ai_flag_reason",
    "ai_dscr_verdict",
    "ai_best_lender",
    "ai_lender_match"
  ],
  "pipeline": [
    "New Bill Uploaded",
    "Extracting / Calculating",
    "Approved - Preliminary (GREEN)",
    "Conditional Review (AMBER)",
    "Needs Review (RED)",
    "Full Underwriting",
    "Lender Submitted",
    "Approved / Funded",
    "Lost"
  ]
}